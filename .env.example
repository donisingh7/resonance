APP_NAME=Resonance
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# AI provider selection: "mock" (default, no external credentials needed)
# or "openai" (requires the OPENAI_* settings below).
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai. Never commit a real key here or
# anywhere in the repo — leave these unset/commented in mock mode.
# OPENAI_API_KEY=
# Model names are deliberately not defaulted in code — set explicitly here
# since model availability changes over time. Examples only, not a
# recommendation of "the latest" model:
# OPENAI_TEXT_MODEL=gpt-4.1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Maximum accepted upload size in megabytes, enforced at the upload endpoint.
# 25 MB is a reasonable default for local development with TXT/PDF/image/
# short audio-video fixtures.
MAX_UPLOAD_SIZE_MB=25

# Frontend
BACKEND_URL=http://localhost:8000
