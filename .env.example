APP_NAME=Resonance
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# AI provider selection. "mock" requires no external credentials and is the
# default for local development and smoke testing.
AI_PROVIDER=mock
# Placeholder for a future real provider's API key. Leave unset in mock mode.
# Never commit a real key here or anywhere in the repo.
# AI_API_KEY=

# Maximum accepted upload size in megabytes, enforced at the upload endpoint.
# 25 MB is a reasonable default for local development with TXT/PDF/image/
# short audio-video fixtures.
MAX_UPLOAD_SIZE_MB=25

# Frontend
BACKEND_URL=http://localhost:8000
